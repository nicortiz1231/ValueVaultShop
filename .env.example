# Copy this file to `.env` and fill in real values.
# `.env` is gitignored -- never commit real tokens to this public repo.
#
# The fastest way to populate `.env` is to link the live store:
#   npx shopify hydrogen link
#   npx shopify hydrogen env pull

# Signs the session cookie. Use a long random string in production.
SESSION_SECRET="replace-with-a-long-random-string"

# --- Shopify Storefront API ---------------------------------------------
# Found in Shopify admin under the Headless channel (or a custom app).
# The public token is safe to expose in the browser; the private one is not.
# The store's real myshopify domain -- not "valuevaultshop.myshopify.com",
# which is a different (unrelated) shop. `hydrogen env pull` sets this for you.
PUBLIC_STORE_DOMAIN="56b8a3-67.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""

# --- Customer Account API (login / order history) ------------------------
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
